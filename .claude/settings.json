{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build *)",
      "Bash(go vet *)",
      "Bash(go test *)",
      "Bash(go list *)",
      "Bash(gofmt -l *)",
      "Bash(gofmt -w *)",
      "Bash(go run ./.claude/skills/schema-change/ddldelta)",
      "Bash(curl -s localhost:9095/*)",
      "Bash(docker compose -f dev-tools/compose/compose.yml up -d *)",
      "Bash(docker compose -f dev-tools/compose/compose.yml ps)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin master)",
      "Bash(git push origin HEAD:master)",
      "Bash(docker compose * down -v*)",
      "Bash(docker volume rm *)",
      "Edit(/go.sum)",
      "Read(/dev-tools/web-api-client/.env*.local)",
      "Read(/dev-tools/web-api-client/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/protect-migrations.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/go-after-edit.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/stop-gate.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
